<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permissions: INTERNET for Firebase (bevaret uændret – trin 1: Original permission) -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Biometric permissions: USE_BIOMETRIC dækker deprecated USE_FINGERPRINT (RETTET: Fjernet USE_FINGERPRINT – trin 4: Deprecated warning løst) -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!-- Application-tag: Alle attributter bevaret uændret (trin 1: Original application-setup) -->
    <application
        android:name=".MyApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="false"
        tools:targetApi="34">

        <!-- MainActivity: Konfig bevaret uændret (trin 1: Original activity-setup) -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">

            <!-- Launcher intent-filter (bevaret uændret – trin 1: Original MAIN/LAUNCHER) -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Firebase Auth email link verification (bevaret uændret – trin 1: Original Firebase-links; RETTET: Sikret self-closing data med scheme/host – trin 2/3: Scheme/host missing løst) -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="byggepiloten.dk"
                    android:pathPrefix="/__/auth/links" />
            </intent-filter>

            <!-- Custom deep links for Android App Links: Verification (bevaret tilføjelse – trin 1: App Links; RETTET: Fuldt self-closing data med scheme/host/path – trin 2/3: Scheme/host missing og tag closed løst) -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="byggepiloten.dk"
                    android:pathPrefix="/verify" />
            </intent-filter>

            <!-- Custom deep links for Android App Links: Reset (bevaret tilføjelse – trin 1: App Links; RETTET: Fuldt self-closing data med scheme/host/path – trin 2/3: Scheme/host missing og tag closed løst) -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="byggepiloten.dk"
                    android:pathPrefix="/reset" />
            </intent-filter>

            <!-- Custom deep links for Android App Links: Confirm (bevaret tilføjelse – trin 1: App Links; RETTET: Fuldt self-closing data med scheme/host/path – trin 2/3: Scheme/host missing og tag closed løst) -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="byggepiloten.dk"
                    android:pathPrefix="/confirm" />
            </intent-filter>

            <!-- Fallback custom scheme (bevaret uændret – trin 1: Original fallback; syntaks-sikret med self-closing data – trin 2: Tag closed løst) -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="byggepiloten" android:host="verify" />
            </intent-filter>

        </activity>

        <!-- Magic Link handler activity (bevaret uændret – trin 1: Original activity) -->
        <activity
            android:name=".ui.SignInLinkHandlerActivity"
            android:exported="true"
            android:launchMode="singleTask" />

    </application>

</manifest>